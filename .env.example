# Copy to .env (repo root) and fill in. Never commit .env.

# --- Database (docker-compose.dev.yml) ---
POSTGRES_USER=picky
POSTGRES_PASSWORD=picky
POSTGRES_DB=picky
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://picky:picky@localhost:5432/picky
# Team Supabase: Dashboard → Connect → Session pooler. When PGHOST is set it wins over DATABASE_URL,
# and the password needs no URL-encoding.
# PGHOST=aws-0-eu-west-1.pooler.supabase.com
# PGPORT=5432
# PGUSER=postgres.<project-ref>
# PGPASSWORD=<database password>
# PGDATABASE=postgres

# --- Object storage (MinIO locally, D19) ---
MINIO_ROOT_USER=picky
MINIO_ROOT_PASSWORD=picky-dev-secret
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=picky-public

# --- Copernicus Data Space (D14, Awais) ---
# https://dataspace.copernicus.eu  -> User settings -> OAuth clients
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- NLS Finland open data (Awais) ---
# https://www.maanmittauslaitos.fi/en/rajapinnat/api-avaimen-ohje
NLS_API_KEY=

# --- Backend ---
DEV_AUTH_BYPASS=true
