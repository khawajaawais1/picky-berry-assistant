# Public, client-side configuration.
#
# Everything prefixed with EXPO_PUBLIC_ is INLINED INTO THE APP BUNDLE and is
# therefore readable by anyone who has the app. Never put a secret, server
# credential, private API key or signing material in this file.
#
# Copy to `.env` and adjust for your machine. `.env` is git-ignored.
# Documented in SECURITY.md and ARCHITECTURE.md.

# development | preview | production
#
# `production` is not only a label: screen 04 accepts a stand-in verification code (`000000`)
# in every other environment so the flow past it can be walked while there is no account
# service, and refuses every code — including that one — here. See ADR-027.
EXPO_PUBLIC_APP_ENV=development

# Absolute https URL of the Picky API. Clear-text http is accepted in
# development only, and only for loopback hosts (localhost/127.0.0.1/::1).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
