# Public, client-side configuration.
#
# Everything prefixed with EXPO_PUBLIC_ is INLINED INTO THE APP BUNDLE and is
# therefore readable by anyone who has the app. Never put a secret, server
# credential, private API key or signing material in this file.
#
# Copy to `.env` and adjust for your machine. `.env` is git-ignored.
# Documented in SECURITY.md and ARCHITECTURE.md.

# development | preview | production
#
# `production` is not only a label: outside it the stand-in session port accepts any non-empty
# password so the flow can be walked while there is no account service, and here it accepts no
# credential — both account screens draw their action disabled. See ADR-054 and ADR-059.
EXPO_PUBLIC_APP_ENV=development

# Absolute https URL of the Picky API. Clear-text http is accepted in
# development only, and only for loopback hosts (localhost/127.0.0.1/::1).
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Firebase's PUBLIC Web API key, used only to ask Firebase to send a password-reset email.
# It is not a secret: it identifies the project rather than authorising access, and must be
# restricted by Firebase's API-key rules. Leave it empty to use the test-build path, where the
# stand-in accepts the request and sends nothing. The email template and the page a new password
# is set on are configured in the Firebase project, not here.
EXPO_PUBLIC_FIREBASE_API_KEY=
