{
  "expo": {
    "name": "Picky",
    "slug": "picky-mobile-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "picky",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "CFBundleLocalizations": ["en", "fi"]
      },
      "bundleIdentifier": "fi.picky.app"
    },
    "android": {
      "package": "fi.picky.app",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#F5F7F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#414BA0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Picky uses your position while the app is open to tell which zone you are picking in."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "android": ["en", "fi"],
            "ios": ["en", "fi"]
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f7a759d-dde7-423f-b7bf-b9f021e6c036"
      }
    },
    "owner": "salmanprottoy"
  }
}
