# id:       ripe_soon
# version:  1.0.0
# feature:  6.7 — reasoning and explainable push alerts (sprint 3)
# owner:    Asmer
#
# sentence:             Ripening {nameEn} in zone {zoneNumber} near {placeName} — yield score {yieldScore}, {confidence} confidence.
# sentenceWithoutPlace: Ripening {nameEn} in zone {zoneNumber} — yield score {yieldScore}, {confidence} confidence.
#
# inputs:   bpa.ttl + species.ttl, plus one run's zone snapshot — the same contract as
#           ripe_nearby.rq (?zone, its bpa:SpeciesAssessment, and the species' own limits).
# output:   one row per zone whose species is ripening and whose habitat can support it,
#           best yield score first.
#
# The heads-up before the season: a zone to plan around, not one to walk to today. It fires on
# bpa:Ripening, the app's own word for "soon", and holds the same suitability floor as
# ripe_nearby so a zone where the species cannot occur never produces either.

PREFIX bpa: <https://picky.example/onto#>

SELECT ?zone ?zoneNumber ?placeName ?species ?speciesCode ?nameEn ?nameFi
       ?yieldScore ?confidence ?zoneSuitability ?ripenessStage
WHERE {
  ?zone a bpa:Zone ;
        bpa:zoneNumber ?zoneNumber ;
        bpa:hasAssessment ?assessment .

  ?assessment bpa:species ?species ;
              bpa:ripenessStage ?ripenessStage ;
              bpa:yieldScore ?yieldScore ;
              bpa:confidence ?confidence ;
              bpa:zoneSuitability ?zoneSuitability .

  ?species bpa:speciesCode ?speciesCode ;
           bpa:nameEn ?nameEn ;
           bpa:nameFi ?nameFi ;
           bpa:minHabitatSuitability ?min .

  # A place is optional: a zone in the middle of the forest has no name to print.
  OPTIONAL { ?zone bpa:placeName ?placeName }

  FILTER(?ripenessStage = bpa:Ripening)
  FILTER(?zoneSuitability >= ?min)
}
ORDER BY DESC(?yieldScore) ?zoneNumber
