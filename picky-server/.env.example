NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/picky
DB_POOL_MAX=10
DB_SSL=disable
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_DAYS=30
MAIL_MODE=console
# The app's public origin (Expo web in development), not the API's PORT above.
APP_PUBLIC_URL=http://localhost:8081
# Browser origins allowed to call the API: the admin console and the Expo web app in development.
# List every deployed console/app origin explicitly; a wildcard is rejected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
DEV_PICKER_PASSWORD=replace-with-a-local-password-at-least-10-chars
# Default operator account created by `npm run seed:users` (development only).
DEV_ADMIN_EMAIL=admin@picky.fi
DEV_ADMIN_PASSWORD=replace-with-a-local-password-at-least-10-chars
DEV_AUTH_BYPASS=true
THROTTLE_LIMIT=300
THROTTLE_DISABLED=false
MAX_BBOX_KM_DETAIL=50
MAX_BBOX_KM_GROUPED=150
MAX_BBOX_KM_SNAPSHOT=60
MIN_REPORTERS_FOR_AVERAGE=3
ANALYTICS_MIN_USERS=3
ANALYTICS_REFRESH_MINUTES=60
ML_SERVICE_URL=https://picky-berry-assistant.onrender.com
ML_API_KEY=
ML_MODE=mock
ML_TIMEOUT_PHOTO_MS=60000
ML_TIMEOUT_MS=20000
ML_BATCH_SIZE=1500
JOBS_RUN_TOKEN=
CRON_SECRET=
JOBS_RUN_BUDGET_MS=40000
MAX_PHOTO_BYTES=4000000
MAX_PHOTOS_PER_SUBMISSION=5
REPORT_WINDOW_DAYS=28
MAX_REPORTS_PER_DAY=10
MAX_KM_FROM_LAST_VISIT=50
CONSENSUS_MIN_USERS=3
