{
  "name": "picky-server-api",
  "version": "1.0.0",
  "description": "Berry Picker Assistant feature 6.2 API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations --envPath .env",
    "seed:scores": "ts-node -r tsconfig-paths/register scripts/seed-dev-scores.ts",
    "db:check-a2": "ts-node scripts/check-a2.ts",
    "db:types": "kysely-codegen --env-file .env --out-file src/db/db.types.ts",
    "openapi:lint": "redocly lint docs/openapi/zones.yaml docs/openapi/auth.yaml docs/openapi/visits.yaml",
    "seed:users": "ts-node -r tsconfig-paths/register scripts/seed-dev-users.ts",
    "make-admin": "ts-node -r tsconfig-paths/register scripts/make-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.0.1",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.1",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.0.1",
    "@nestjs/swagger": "11.0.6",
    "@nestjs/throttler": "6.4.0",
    "argon2": "^0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "compression": "1.8.1",
    "dotenv": "16.4.7",
    "h3-js": "4.2.1",
    "helmet": "8.1.0",
    "joi": "17.13.3",
    "js-yaml": "4.1.1",
    "kysely": "0.27.6",
    "nestjs-pino": "4.4.0",
    "pg": "8.13.1",
    "postgres": "^4.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@eslint/js": "9.18.0",
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.1",
    "@redocly/cli": "1.34.5",
    "@types/compression": "1.7.5",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.0.0",
    "@types/pg": "8.11.10",
    "@types/supertest": "7.2.1",
    "eslint": "9.18.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.2",
    "globals": "17.0.0",
    "jest": "29.7.0",
    "kysely-codegen": "0.17.0",
    "node-pg-migrate": "7.9.1",
    "prettier": "3.4.2",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
